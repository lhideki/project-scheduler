{
  "name": "project-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "依存関係・マイルストーン・スプリントを考慮した自動スケジューリング機能を持つ、単一HTMLで動くWBS/ガントチャート型のプロジェクト管理ツール。",
  "type": "module",
  "scripts": {
    "build:js": "esbuild src/entry.jsx --bundle --minify --format=iife --legal-comments=eof --outfile=dist/bundle.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "build:html": "node scripts/build-html.mjs",
    "build:docs": "node scripts/build-json-doc.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "build": "npm run build:js && npm run build:css && npm run build:html && npm run build:docs && npm run build:agent",
    "dev:js": "esbuild src/entry.jsx --bundle --loader:.jsx=jsx --outfile=dist/bundle.dev.js --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
